# Railway 合并部署 Dockerfile
# 使用此 Dockerfile 将所有服务合并部署到一个容器中

FROM python:3.12-slim

# 设置工作目录
WORKDIR /app

# 安装系统依赖
RUN apt-get update && apt-get install -y \
    gcc \
    default-libmysqlclient-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# 复制所有服务的依赖文件
COPY services/gateway/requirements.txt requirements-gateway.txt
COPY services/user-service/requirements.txt requirements-user.txt
COPY services/ticket-service/requirements.txt requirements-ticket.txt
COPY services/ai-service/requirements.txt requirements-ai.txt
COPY services/order-service/requirements.txt requirements-order.txt
COPY services/notification-service/requirements.txt requirements-notification.txt

# 安装所有依赖
RUN pip install --no-cache-dir \
    -r requirements-gateway.txt \
    -r requirements-user.txt \
    -r requirements-ticket.txt \
    -r requirements-ai.txt \
    -r requirements-order.txt \
    -r requirements-notification.txt

# 复制项目文件
COPY . .

# 设置环境变量
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

# 暴露端口（Gateway 端口）
EXPOSE 8000

# 启动命令
CMD ["python", "start_all.py"]
