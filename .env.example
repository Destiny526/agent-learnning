# ============================================================
# AI 智能出行助手 - 环境变量配置
# 复制此文件为 .env 并修改以下配置:
#   cp .env.example .env
#
# ⚠️ 生产环境务必更换所有密码和密钥！
# ============================================================

# ── 必须修改：数据库密码 ──
MYSQL_ROOT_PASSWORD=CHANGE_ME_mysql_root_password
MYSQL_PASSWORD=CHANGE_ME_mysql_user_password

# ── 必须修改：JWT 密钥（至少 32 位随机字符串）──
# 生成方式: openssl rand -base64 32
JWT_SECRET_KEY=CHANGE_ME_jwt_secret_at_least_32_chars

# ── MySQL 配置 ──
MYSQL_DATABASE=travel_assistant
MYSQL_USER=travel_user
MYSQL_PORT=3306

# ── Redis 配置 ──
# 生产环境建议设置密码
REDIS_PASSWORD=
REDIS_PORT=6379

# ── 应用端口 ──
APP_PORT=3000
GATEWAY_PORT=8000

# ── LLM 配置（AI 行程规划功能）──
# DeepSeek API（主要模型，推荐）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# OpenAI API（后备模型，可选）
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-3.5-turbo

# LLM 配置
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3
LLM_FALLBACK_ENABLED=true

# ── Qdrant 向量数据库配置（RAG 功能，可选）──
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# Embedding 配置（需要 OPENAI_API_KEY）
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
