# ============================================================
# Railway 部署环境变量配置
# 复制此文件中的内容到 Railway 控制台的 Variables 标签页
# ============================================================

# ── JWT 配置（所有服务共享）──
JWT_SECRET_KEY=your-secret-key-change-this
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── MySQL 配置（使用 Railway MySQL 插件时自动提供）──
# 如果使用 Railway 的 MySQL 插件，以下变量会自动注入
# MYSQL_HOST=mysql.railway.internal
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=your-mysql-password
# MYSQL_DATABASE=railway
# MYSQL_URL=mysql://root:password@mysql.railway.internal:3306/railway

# ── Redis 配置（使用 Railway Redis 插件时自动提供）──
# 如果使用 Railway 的 Redis 插件，以下变量会自动注入
# REDIS_HOST=redis.railway.internal
# REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password
# REDIS_URL=redis://default:password@redis.railway.internal:6379

# ── Gateway 服务配置（独立部署时需要）──
# 如果使用独立部署方式，需要配置以下变量
# USER_SERVICE_URL=http://user-service.railway.internal:8001
# TICKET_SERVICE_URL=http://ticket-service.railway.internal:8002
# AI_SERVICE_URL=http://ai-service.railway.internal:8003
# ORDER_SERVICE_URL=http://order-service.railway.internal:8004
# NOTIFICATION_SERVICE_URL=http://notification-service.railway.internal:8005

# ── AI Service 配置 ──
WEIGHT_TIME=0.40
WEIGHT_PRICE=0.30
WEIGHT_DURATION=0.20
WEIGHT_COMFORT=0.10
TIME_DECAY_WINDOW=360
SEARCH_WINDOW_HOURS=12
CACHE_TICKETS_TTL=1800
CACHE_RECOMMEND_TTL=600
CACHE_TICKET_TTL=3600
CACHE_EMPTY_TTL=300

# ── 前端配置（如果单独部署前端）──
# NEXT_PUBLIC_API_URL=https://your-gateway-url.up.railway.app
# NEXT_PUBLIC_USE_MOCK=false
